# Copier ce fichier en .env. Sans DATABASE_URL, le site fonctionne en mode
# invité : la progression reste dans le navigateur et les comptes sont fermés.

# Base locale lancée par `docker compose up -d` ; en production, la chaîne
# de connexion « pooled » de Neon.
DATABASE_URL="postgresql://onepiecemind:onepiecemind@localhost:5433/onepiecemind"

# Adresse publique du site, sans barre finale.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pseudos des administrateurs, séparés par des virgules : ils peuvent supprimer
# n'importe quel quiz de la communauté, remettre en ligne un quiz masqué et
# suivre les inscriptions et les joueurs sur /admin.
ADMIN_USERNAMES=""
