// Comptes et progression des joueurs. Les règles du jeu (gains, recrutement,
// bonus) sont dans src/lib/economy ; cette base ne fait que conserver l'état.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  /// Pseudo tel que le joueur l'a écrit.
  username     String
  /// Pseudo en minuscules : deux pseudos ne peuvent pas différer par la seule casse.
  usernameKey  String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  /// Dernière visite avec une session ouverte, à quelques minutes près ; vide tant que le joueur n'est pas revenu.
  lastSeenAt   DateTime?

  berrys         Int    @default(0)
  /// Total gagné depuis la création du compte : fixe la prime du joueur.
  lifetimeBerrys Int    @default(0)
  games          Int    @default(0)
  /// Gains du jour (date de Paris), pour le plafond journalier.
  dayKey         String @default("")
  dayEarned      Int    @default(0)
  /// Jeux du jour déjà validés à cette date (liste d'identifiants).
  dayDone        Json   @default("[]")
  /// Avancement des défis quotidiens à cette date ({ progress, done }).
  dayChallenges  Json   @default("{}")
  /// Parcours par jeu ({ jeu: { games, best, bestBy } }), pour les objectifs.
  stats          Json   @default("{}")
  /// Avancement des défis de la semaine ({ key, progress, done }).
  week           Json   @default("{}")
  /// Cosmétiques achetés ou gagnés (liste d'identifiants), et ceux qui sont portés ({ emplacement: identifiant }).
  cosmetics      Json   @default("[]")
  equipped       Json   @default("{}")
  /// Équipages enregistrés ([{ id, name, crew: { poste: personnage } }]) : des compositions à remettre en place d'un geste.
  savedCrews     Json   @default("[]")

  /// Classé : cote du joueur pour la saison `rankedSeason` (« 2026-10 »), vide tant qu'il n'a jamais joué.
  rating       Int    @default(1000)
  rankedSeason String @default("")
  rankedGames  Int    @default(0)
  rankedWins   Int    @default(0)

  sessions   Session[]
  collection CollectionEntry[]
  crew       CrewSlot[]
  results    GameResult[]

  roomPlayers      RoomPlayer[]
  friendsRequested Friendship[] @relation("requester")
  friendsReceived  Friendship[] @relation("addressee")
  invitesSent      RoomInvite[] @relation("inviteFrom")
  invitesReceived  RoomInvite[] @relation("inviteTo")

  quizzes     Quiz[]
  quizDrafts  QuizDraft[]
  quizReports QuizReport[]
  quizPlays   QuizPlay[]

  tradesProposed Trade[] @relation("tradeFrom")
  tradesReceived Trade[] @relation("tradeTo")

  rankedQueue   RankedQueue?
  rankedSeasons RankedSeasonResult[]
  raids         RaidParticipant[]
  raidAttacks   RaidAttack[]
  listings      MarketListing[] @relation("listingSeller")
  purchases     MarketListing[] @relation("listingBuyer")

  @@index([rankedSeason, rating])
}

model Session {
  /// Empreinte SHA-256 du jeton : le jeton lui-même n'existe que dans le cookie.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  pushSubscriptions PushSubscription[]

  @@index([userId])
}

/// Appareil qui reçoit les notifications push. L'abonnement suit la session du navigateur : il disparaît avec elle.
model PushSubscription {
  /// Adresse du service de notification du navigateur.
  endpoint  String   @id
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Clés du navigateur, pour chiffrer les messages qui lui sont envoyés.
  p256dh    String
  auth      String
  /// Langue des notifications : celle du site lors de la dernière visite.
  lang      String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model CollectionEntry {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  count       Int      @default(1)
  golden      Int      @default(0)
  firstAt     DateTime @default(now())

  @@id([userId, characterId])
}

model CrewSlot {
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        String
  characterId String

  @@id([userId, post])
}

/// Une partie récompensée. La contrainte d'unicité empêche de faire payer deux fois la même.
model GameResult {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug       String
  /// Graine du tirage, ou « daily:AAAA-MM-JJ » pour le défi du jour.
  reportKey  String
  mode       String
  difficulty String?
  score      Int
  maxScore   Int
  /// Essais qu'il a fallu pour trouver (OnePiecedle) ; nul ailleurs, ou si rien n'a été trouvé.
  attempts   Int?
  berrys     Int
  recruitId  String?
  createdAt  DateTime @default(now())

  @@unique([userId, slug, reportKey])
  @@index([userId, createdAt])
}

/// Compteur de tentatives de connexion, par pseudo et par adresse.
model AuthThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// Salon multijoueur. Tout son état est ici : chaque joueur le relit environ une fois par seconde.
model Room {
  id         String   @id @default(cuid())
  /// Code à cinq caractères que l'hôte partage.
  code       String   @unique
  mode       String
  /// Langue des questions (fr ou en) : celle de l'hôte.
  lang       String   @default("fr")
  difficulty String
  /// Quiz dans lesquels les questions sont tirées (liste d'identifiants).
  games      Json
  questionCount Int
  /// Temps de réponse par question, en secondes.
  seconds    Int
  /// Graine du tirage : les questions sont recalculées à la demande, jamais stockées.
  seed       Int
  /// lobby, playing ou finished.
  status     String   @default("lobby")
  questionIndex Int   @default(0)
  /// countdown (duel classé sur le point de commencer), question (on répond) ou reveal (correction affichée).
  phase      String   @default("question")
  phaseStartedAt DateTime?
  phaseEndsAt    DateTime?
  /// Augmente à chaque changement : un joueur à jour n'a rien à recharger.
  version    Int      @default(0)
  hostId     String?
  /// friendly (salon à code) ou ranked (duel classé, ouvert par la file d'attente).
  kind       String   @default("friendly")
  /// Duel classé : les cotes ont été mises à jour.
  settledAt  DateTime?
  createdAt  DateTime @default(now())

  players RoomPlayer[]
  answers RoomAnswer[]
  invites RoomInvite[]

  @@index([createdAt])
}

model RoomPlayer {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Compte du joueur, s'il est connecté ; un invité n'en a pas.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  nameKey    String
  /// Empreinte du jeton qui identifie ce joueur dans ce salon.
  tokenHash  String
  score      Int      @default(0)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Les Berrys de la partie ont été versés.
  rewarded   Boolean  @default(false)
  rewardBerrys Int    @default(0)

  answers RoomAnswer[]

  @@unique([roomId, nameKey])
  @@index([roomId])
}

model RoomAnswer {
  roomId        String
  room          Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId      String
  player        RoomPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionIndex Int
  optionId      String
  correct       Boolean
  points        Int
  answeredAt    DateTime   @default(now())

  @@id([playerId, questionIndex])
  @@index([roomId, questionIndex])
}

/// Lien d'amitié : en attente tant que le destinataire n'a pas accepté.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  /// pending ou accepted.
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// Invitation d'un ami dans un salon.
model RoomInvite {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromId    String
  from      User     @relation("inviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("inviteTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([roomId, toId])
  @@index([toId])
}

/// Quiz écrit par un joueur. Il se joue en Duo, Carré ou Cash.
model Quiz {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  /// anime ou manga : ce qu'il faut avoir vu pour ne pas être spoilé.
  spoiler     String
  /// Langue dans laquelle le quiz est rédigé : fr ou en. Les quiz d'avant ce champ sont en français.
  language    String    @default("fr")
  /// Questions ({ prompt, answer, wrong, alternatives }), validées à l'écriture et à la lecture.
  questions   Json
  /// public, ou hidden après plusieurs signalements.
  status      String    @default("public")
  /// Relu par un administrateur : les signalements ne le masquent plus.
  reviewedAt  DateTime?
  /// Nombre de comptes qui l'ont terminé.
  plays       Int       @default(0)
  createdAt   DateTime  @default(now())

  reports   QuizReport[]
  results   QuizPlay[]
  thumbnail QuizThumbnail?

  @@index([status, createdAt])
  @@index([authorId])
}

/// Brouillon de quiz, visible de son seul auteur. Ce n'est pas encore un quiz : rien n'y est exigé.
model QuizDraft {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Le formulaire tel qu'il a été enregistré ({ title, description, spoiler, language, thumbnail, questions }) :
  /// borné à l'écriture, validé pour de bon à la publication seulement.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, updatedAt])
}

/// Vignette d'un quiz, à part : la liste des quiz ne charge pas les images.
model QuizThumbnail {
  quizId String @id
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Image JPEG, réduite par le navigateur avant l'envoi et vérifiée à l'écriture.
  data   Bytes
}

/// Signalement d'un quiz par un joueur : un seul par joueur et par quiz.
model QuizReport {
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@id([quizId, userId])
}

/// Résultat d'un joueur sur un quiz : sa première partie terminée est la seule récompensée.
model QuizPlay {
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Meilleur score du joueur sur ce quiz.
  score     Int
  maxScore  Int
  berrys    Int      @default(0)
  createdAt DateTime @default(now())

  @@id([quizId, userId])
  @@index([userId, createdAt])
}

/// Échange proposé entre deux amis : un avis contre un avis.
model Trade {
  id              String    @id @default(cuid())
  fromId          String
  from            User      @relation("tradeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId            String
  to              User      @relation("tradeTo", fields: [toId], references: [id], onDelete: Cascade)
  /// Avis que donne celui qui propose.
  offeredId       String
  /// Son exemplaire doré plutôt qu'un ordinaire.
  offeredGolden   Boolean   @default(false)
  /// Avis qu'il demande en retour.
  requestedId     String
  requestedGolden Boolean   @default(false)
  /// pending, accepted, declined ou cancelled.
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  answeredAt      DateTime?

  @@index([toId, status])
  @@index([fromId, status])
}

/// File d'attente du classé : un joueur qui cherche un adversaire, puis le duel qu'on lui a trouvé.
model RankedQueue {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Langue des questions : on n'affronte qu'un joueur de la même langue.
  lang       String
  rating     Int
  joinedAt   DateTime @default(now())
  /// Dernier signe de vie : un joueur qui a fermé la page n'est plus proposé à personne.
  lastSeenAt DateTime @default(now())
  /// Code du salon du duel, une fois l'adversaire trouvé.
  roomCode   String?

  @@index([lang, roomCode, lastSeenAt])
}

/// Duel classé terminé : scores, et cote de chaque joueur avant et après.
model RankedMatch {
  id        String   @id @default(cuid())
  /// Salon du duel. Les salons sont supprimés au bout d'un jour, les duels restent.
  roomId    String   @unique
  season    String
  playerAId String
  playerBId String
  nameA     String
  nameB     String
  scoreA    Int
  scoreB    Int
  ratingA   Int
  ratingB   Int
  deltaA    Int
  deltaB    Int
  createdAt DateTime @default(now())

  @@index([playerAId, createdAt])
  @@index([playerBId, createdAt])
}

/// Bilan d'une saison classée pour un joueur, écrit quand il revient après la fin de la saison.
model RankedSeasonResult {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    String
  rating    Int
  games     Int
  wins      Int
  /// Berrys versés pour la ligue atteinte.
  berrys    Int
  createdAt DateTime @default(now())

  @@id([userId, season])
  @@index([season, rating])
}

/// Raid de la semaine : toute la communauté contre un même adversaire.
model Raid {
  /// Semaine du raid, au format « 2026-S40 ».
  week       String    @id
  bossId     String
  hp         Int
  damage     Int       @default(0)
  defeatedAt DateTime?
  createdAt  DateTime  @default(now())

  participants RaidParticipant[]
  attacks      RaidAttack[]
}

model RaidParticipant {
  week    String
  raid    Raid    @relation(fields: [week], references: [week], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  damage  Int     @default(0)
  attacks Int     @default(0)
  /// Le butin du raid vaincu a été récupéré.
  claimed Boolean @default(false)
  /// Date du premier assaut : à dégâts égaux, le premier arrivé est devant.
  firstAt DateTime @default(now())

  @@id([week, userId])
  @@index([week, damage])
  @@index([userId, claimed])
}

/// Un assaut : dix questions tirées par le serveur, dont la graine ne quitte pas la base.
model RaidAttack {
  id         String    @id @default(cuid())
  week       String
  raid       Raid      @relation(fields: [week], references: [week], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seed       Int
  mode       String
  lang       String
  /// Jour de l'assaut (date de Paris), pour la limite quotidienne.
  dayKey     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  correct    Int       @default(0)
  damage     Int       @default(0)
  berrys     Int       @default(0)

  @@index([userId, dayKey])
}

/// Annonce du marché : un exemplaire d'avis mis en vente. L'exemplaire quitte la collection du vendeur tant que l'annonce est ouverte.
model MarketListing {
  id          String    @id @default(cuid())
  sellerId    String
  seller      User      @relation("listingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  characterId String
  golden      Boolean   @default(false)
  price       Int
  /// active, sold ou cancelled.
  status      String    @default("active")
  buyerId     String?
  buyer       User?     @relation("listingBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  /// Ce que le vendeur a reçu, taxe déduite.
  proceeds    Int       @default(0)
  createdAt   DateTime  @default(now())
  soldAt      DateTime?
  /// Le vendeur a vu que son annonce était vendue.
  seenAt      DateTime?

  @@index([status, createdAt])
  @@index([sellerId, status])
  @@index([characterId, status])
}
